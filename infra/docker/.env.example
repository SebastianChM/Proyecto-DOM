# Docker Environment Configuration
# Copy to .env in the same directory as docker-compose.yml

# PostgreSQL
POSTGRES_DB=dom_bim
POSTGRES_USER=dom-bim
POSTGRES_PASSWORD=your_secure_password_here

# Database URL (must match POSTGRES credentials)
DATABASE_URL=postgresql://dom_bim:your_secure_password_here@postgres:5432/dom_bim

# Redis (optional, leave empty for no password)
REDIS_PASSWORD=
