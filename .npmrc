# ─── npm security hardening (supply chain attack mitigation) ──────────────────
#
# Background: lifecycle scripts (preinstall/install/postinstall) run arbitrary
# code during `npm install`. A compromised package can exfiltrate secrets or
# backdoor the dev environment through this mechanism.
#
# This project has 10 packages with install scripts — all are well-known and
# high-scrutiny (prisma, esbuild, sharp, puppeteer…). The Docker production
# stage already uses --ignore-scripts. For full protection, migrate to pnpm 11
# which supports `onlyBuiltDependencies` (allowlist per package).

# Fail `npm audit` on high or critical severity CVEs.
# Run `npm audit fix` before merging if this blocks CI.
audit-level=high

# Pin exact versions when running `npm install <pkg>` or `npm add <pkg>`.
# Prevents silent ^ / ~ range bumps when adding new dependencies.
save-exact=true

# Enforce the `engines` field in package.json (Node >=20.11.0, npm >=10.0.0).
# Prevents accidental installs on incompatible runtime versions.
engine-strict=true

# Disable scarf telemetry (@scarf/scarf reports usage data on install).
# Set SCARF_ANALYTICS=false in your shell profile for local development.
# The Docker images set this via ENV instruction.
