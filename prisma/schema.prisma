generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  apsUserId String?
  role      String   @default("USER") // Enum: USER, ADMIN
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects  Project[]
  files     File[]
}

model Project {
  id          String   @id @default(uuid())
  name        String
  description String?
  status      String   @default("Active") // Active, Archived, Draft
  clientName  String?
  location    String?
  startDate   DateTime?
  endDate     DateTime?
  discipline  String?
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  files       File[]
  comparisons Comparison[]
}

model File {
  id             String      @id @default(uuid())
  name           String
  originalName   String
  type           String      // Enum: RVT, DWG, PDF, IFC, NWC, DWF, OTHER
  size           Int
  s3Key          String
  apsUrn         String?
  status         String      @default("UPLOADED") // Enum: UPLOADED, TRANSLATING, READY, FAILED
  
  // APS Data Management fields for ACC/BIM 360 files
  apsProjectId   String?     // ACC/BIM 360 project ID
  apsItemId      String?     // Item ID in APS Data Management
  apsHubId       String?     // Hub ID
  apsFolderId    String?     // Folder ID
  apsStorageId   String?     // Storage ID for version tracking
  
  projectId      String
  project        Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId         String
  user           User        @relation(fields: [userId], references: [id])
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  versions       FileVersion[]
  conversions    Conversion[]
  comparisonsAsBase Comparison[] @relation("BaseFile")
  comparisonsAsTarget Comparison[] @relation("TargetFile")
}

model FileVersion {
  id        String   @id @default(uuid())
  fileId    String
  file      File     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  version   Int
  apsUrn    String
  createdAt DateTime @default(now())

  @@unique([fileId, version])
}

model Conversion {
  id           String          @id @default(uuid())
  fileId       String
  file         File            @relation(fields: [fileId], references: [id], onDelete: Cascade)
  targetFormat String
  status       String          @default("PENDING") // Enum: PENDING, PROCESSING, COMPLETED, FAILED
  resultUrn    String?
  resultUrl    String?
  error        String?
  createdAt    DateTime        @default(now())
  completedAt  DateTime?
}

model Comparison {
  id          String           @id @default(uuid())
  projectId   String
  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  baseFileId  String
  baseFile    File             @relation("BaseFile", fields: [baseFileId], references: [id])
  targetFileId String
  targetFile  File             @relation("TargetFile", fields: [targetFileId], references: [id])
  type        String           // Enum: RVT_VS_RVT, PDF_VS_RVT, PDF_VS_PDF
  status      String           @default("PENDING") // Enum: PENDING, PROCESSING, COMPLETED, FAILED
  diffId      String?
  result      String?          // Stored as JSON string
  createdAt   DateTime         @default(now())
  completedAt DateTime?
}

// --- APS Data Management Layer (Local Catalog) ---

model ApsHub {
  id          String       @id // APS Hub ID (b.xxxx)
  name        String
  region      String?
  projects    ApsProject[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model ApsProject {
  id           String      @id // APS Project ID (b.yyyy)
  hubId        String
  hub          ApsHub      @relation(fields: [hubId], references: [id])
  name         String
  rootFolderId String?     // ID of the top-level folder
  folders      ApsFolder[]
  items        ApsItem[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model ApsFolder {
  id          String      @id // APS Folder ID
  name        String
  projectId   String
  project     ApsProject  @relation(fields: [projectId], references: [id])
  parentId    String?
  parent      ApsFolder?  @relation("FolderHierarchy", fields: [parentId], references: [id])
  children    ApsFolder[] @relation("FolderHierarchy")
  items       ApsItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model ApsItem {
  id          String      @id // APS Item ID
  name        String
  folderId    String
  folder      ApsFolder   @relation(fields: [folderId], references: [id])
  projectId   String
  project     ApsProject  @relation(fields: [projectId], references: [id])
  versions    ApsVersion[]
  currentVersionId String?
  
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model ApsVersion {
  id            String   @id // APS Version ID
  itemId        String
  item          ApsItem  @relation(fields: [itemId], references: [id])
  versionNumber Int
  urn           String
  mimeType      String?
  storageSize   Int?
  createdAt     DateTime @default(now())
}
