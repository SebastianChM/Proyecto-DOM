<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>Validation Report - {{projectName}}</title>
    <style>
        body { font-family: 'Helvetica', 'Arial', sans-serif; color: #333; line-height: 1.6; }
        .header { display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #005691; padding-bottom: 20px; margin-bottom: 30px; }
        .logo { color: #005691; font-size: 24px; font-weight: bold; }
        .meta { text-align: right; font-size: 14px; color: #666; }
        h1 { color: #005691; font-size: 28px; margin-bottom: 5px; }
        h2 { font-size: 18px; border-bottom: 1px solid #ddd; padding-bottom: 10px; margin-top: 30px; color: #444; }
        .summary-box { background: #f9f9f9; padding: 20px; border-radius: 8px; border-left: 5px solid #005691; display: flex; justify-content: space-around; margin-bottom: 30px; }
        .stat { text-align: center; }
        .stat-value { font-size: 24px; font-weight: bold; color: #333; }
        .stat-label { font-size: 12px; text-transform: uppercase; color: #777; }
        table { width: 100%; border-collapse: collapse; margin-top: 20px; font-size: 12px; }
        th { background: #005691; color: white; text-align: left; padding: 10px; }
        td { border-bottom: 1px solid #eee; padding: 10px; }
        tr:nth-child(even) { background: #fdfdfd; }
        .badge { padding: 4px 8px; border-radius: 4px; font-size: 10px; font-weight: bold; color: white; }
        .badge-HIGH { background: #e53935; }
        .badge-MEDIUM { background: #fb8c00; }
        .badge-LOW { background: #43a047; }
        .footer { position: fixed; bottom: 30px; left: 0; right: 0; text-align: center; font-size: 10px; color: #999; border-top: 1px solid #eee; padding-top: 20px; }
    </style>
</head>
<body>
    <div class="header">
        <div class="logo">DOM</div>
        <div class="meta">
            <div>Project: {{projectName}}</div>
            <div>Date: {{generatedAt}}</div>
            <div>Run ID: {{runId}}</div>
        </div>
    </div>

    <h1>Validation Report</h1>
    <p>Automated analysis of Model vs Engineering Table.</p>

    <div class="summary-box">
        <div class="stat">
            <div class="stat-value">{{totalIssues}}</div>
            <div class="stat-label">Total Issues</div>
        </div>
        <div class="stat">
            <div class="stat-value">{{missingCount}}</div>
            <div class="stat-label" style="color: #e53935">Missing</div>
        </div>
        <div class="stat">
            <div class="stat-value">{{mismatchCount}}</div>
            <div class="stat-label" style="color: #fb8c00">Mismatch</div>
        </div>
        <div class="stat">
            <div class="stat-value">{{undocumentedCount}}</div>
            <div class="stat-label" style="color: #757575">Undocumented</div>
        </div>
    </div>

    <h2>Detailed Findings</h2>
    <table>
        <thead>
            <tr>
                <th width="10%">Tag</th>
                <th width="15%">Type</th>
                <th width="10%">Severity</th>
                <th width="35%">Message</th>
                <th width="30%">Description</th>
            </tr>
        </thead>
        <tbody>
            {{#each issues}}
            <tr>
                <td><strong>{{elementTag}}</strong></td>
                <td>{{elementType}}</td>
                <td><span class="badge badge-{{severity}}">{{severity}}</span></td>
                <td>{{message}}</td>
                <td>
                    {{description}}
                    {{#if expectedValue}}
                    <br><em style="color:#666">Exp: {{expectedValue}} / Act: {{actualValue}}</em>
                    {{/if}}
                </td>
            </tr>
            {{/each}}
        </tbody>
    </table>

    <div class="footer">
        Generated by DOM BIM Platform | Confidential Document
    </div>
</body>
</html>
