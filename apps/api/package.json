{
  "name": "dom-bim-api",
  "version": "1.0.0",
  "description": "DOM BIM Platform - API Backend",
  "main": "dist/src/index.js",
  "prisma": {
    "schema": "../../packages/database/prisma/schema.prisma"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/src/index.js",
    "test": "jest",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "dev:worker": "cross-env RUN_WORKERS=true ts-node-dev --respawn --transpile-only src/worker.ts",
    "start:worker": "node dist/src/worker.js",
    "deploy:plugin": "ts-node-dev scripts/deploy-da-bundle.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.7.0",
    "@types/express-session": "^1.18.2",
    "archiver": "^7.0.1",
    "axios": "^1.13.2",
    "bullmq": "^5.0.0",
    "connect-redis": "^7.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-session": "^1.18.2",
    "forge-apis": "^0.9.11",
    "form-data": "^4.0.5",
    "fs-extra": "^11.3.2",
    "handlebars": "^4.7.8",
    "helmet": "^7.1.0",
    "ioredis": "^5.8.2",
    "mammoth": "^1.11.0",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.11",
    "pdf-parse": "^1.1.1",
    "pdf.js-extract": "^0.2.1",
    "puppeteer": "^24.32.0",
    "socket.io": "^4.8.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^9.0.1",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^30.0.0",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.5",
    "@types/nodemailer": "^7.0.4",
    "@types/pdf-parse": "^1.1.5",
    "@types/pdfkit": "^0.17.4",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^9.0.8",
    "jest": "^30.2.0",
    "pdfkit": "^0.17.2",
    "prisma": "^5.7.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.6",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  },
  "optionalDependencies": {
    "@sentry/node": "^9.27.0"
  }
}
