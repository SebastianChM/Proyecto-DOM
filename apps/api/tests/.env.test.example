# Test Environment Configuration
# Copy this file to .env.test and customize for your environment

# API Configuration
API_URL=http://localhost:8080

# Webhook Testing
APS_WEBHOOK_SIGNING_SECRET=CHANGE_ME_MUST_MATCH_APS_CONSOLE

# Test User (optional)
TEST_USER_EMAIL=test@example.com
TEST_USER_ID=test-user-id

# Redis (for test isolation)
REDIS_HOST=localhost
REDIS_PORT=6379

# Database (use separate test database)
# DATABASE_URL=postgresql://user:password@localhost:5432/dom_bim_test

# Logging (reduce noise during tests)
LOG_LEVEL=error
