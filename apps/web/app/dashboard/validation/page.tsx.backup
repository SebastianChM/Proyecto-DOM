"use client"

import { useState, useEffect } from "react"
import axios from "axios"
import { 
    Upload, 
    Loader2, 
    FileSearch, 
    AlertCircle,
    CheckCircle2,
    XOctagon,
    AlertOctagon,
    FileQuestion,
    X,
    Layers,
    Settings,
    BarChart3,
    Filter,
    TrendingUp
} from "lucide-react"
import { Button } from "@/components/ui/button"
import { Card, CardContent, CardHeader, CardTitle, CardDescription } from "@/components/ui/card"
import { toast } from "sonner"
import { showError } from "@/lib/error-handler"
import { useUser } from "@/context/UserContext"

interface ValidationResult {
    id: string
    instrumentTag: string
    status: 'missing' | 'mismatch' | 'ok' | 'undocumented'
    etData?: any
    modelData?: any
    message: string
}

interface ValidationSummary {
    total: number
    ok: number
    missing: number
    mismatch: number
    undocumented: number
    issues: number
}

interface Project {
    id: string
    name: string
    description?: string
    files: any[]
}

export default function ValidationPage() {
    const { user } = useUser()
    const [projects, setProjects] = useState<Project[]>([])
    const [selectedProject, setSelectedProject] = useState<Project | null>(null)
    const [selectedFiles, setSelectedFiles] = useState<string[]>([])
    const [etDocument, setEtDocument] = useState<File | null>(null)
    const [validationResults, setValidationResults] = useState<ValidationResult[]>([])
    const [validationSummary, setValidationSummary] = useState<ValidationSummary | null>(null)
    const [loading, setLoading] = useState(false)
    const [validating, setValidating] = useState(false)
    const [error, setError] = useState<string | null>(null)
    const [notifications, setNotifications] = useState<string[]>([])
    const [filterStatus, setFilterStatus] = useState<string>('all')
    const [showProjectDropdown, setShowProjectDropdown] = useState(false)
    const API_URL = process.env.NEXT_PUBLIC_API_URL || 'http://localhost:8080'

    // Error boundary effect
    useEffect(() => {
        const handleError = (event: ErrorEvent) => {
            console.error('Validation page error:', event.error)
            setError('An error occurred in the validation module. The rest of the application continues to work.')
            event.preventDefault()
        }

        window.addEventListener('error', handleError)
        return () => window.removeEventListener('error', handleError)
    }, [])

    useEffect(() => {
        const fetchProjects = async () => {
            try {
                setLoading(true)
                const response = await axios.get(`${API_URL}/api/projects`)
                setProjects(Array.isArray(response.data) ? response.data : [])
                setError(null)
            } catch (error) {
                console.error('Failed to load projects:', error)
                showError(error, user?.role, "Failed to load projects")
                setProjects([])
                setError('Failed to load projects. Please check your connection.')
            } finally {
                setLoading(false)
            }
        }
        fetchProjects()
    }, [user?.role])

    const handleETUpload = (e: React.ChangeEvent<HTMLInputElement>) => {
        if (e.target.files && e.target.files[0]) {
            const file = e.target.files[0]
            const allowedTypes = [
                'application/pdf',
                'application/msword',
                'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
                'text/markdown',
                'text/plain'
            ]
            const allowedExtensions = ['.pdf', '.doc', '.docx', '.md', '.txt']
            const fileExt = file.name.toLowerCase().slice(file.name.lastIndexOf('.'))
            
            if (allowedTypes.includes(file.type) || allowedExtensions.includes(fileExt)) {
                setEtDocument(file)
                toast.success(`ET document selected: ${file.name}`)
            } else {
                toast.error('Please select a PDF, Word, Markdown, or Text document')
            }
        }
    }

    const handleValidation = async () => {
        if (!selectedProject) {
            toast.error('Please select a project')
            return
        }

        if (!etDocument) {
            toast.error('Please upload an ET document')
            return
        }

        if (selectedFiles.length === 0) {
            toast.error('Please select at least one model file')
            return
        }

        try {
            setValidating(true)
            setError(null)

            // Step 1: Upload ET document
            const formData = new FormData()
            formData.append('file', etDocument)
            formData.append('projectId', selectedProject.id)
            formData.append('type', 'et-document')

            toast.info('Uploading ET document...')
            const uploadResponse = await axios.post(
                `${API_URL}/api/validation/upload-et`,
                formData,
                { 
                    headers: { 'Content-Type': 'multipart/form-data' },
                    timeout: 60000 // 60 second timeout
                }
            )

            const etDocumentId = uploadResponse.data.id

            // Step 2: Start validation process
            toast.info('Analyzing ET document and models...')
            const validationResponse = await axios.post(
                `${API_URL}/api/validation/validate`,
                {
                    projectId: selectedProject.id,
                    etDocumentId: etDocumentId,
                    selectedFiles: selectedFiles
                },
                { timeout: 120000 } // 2 minute timeout
            )

            const results = validationResponse.data.results || []
            const summary = validationResponse.data.summary || {}
            
            setValidationResults(results)
            setValidationSummary(summary)
            
            // Generate detailed notifications for each issue
            const newNotifications: string[] = []
            results.forEach((result: ValidationResult) => {
                if (result.status === 'missing') {
                    newNotifications.push(`MISSING: ${result.instrumentTag} - ${result.message}`)
                } else if (result.status === 'mismatch') {
                    newNotifications.push(`MISMATCH: ${result.instrumentTag} - ${result.message}`)
                } else if (result.status === 'undocumented') {
                    newNotifications.push(`UNDOCUMENTED: ${result.instrumentTag} - ${result.message}`)
                }
            })
            setNotifications(newNotifications)
            
            toast.success(
                `Validation complete: ${summary.total || 0} instruments checked, ` +
                `${summary.issues || 0} issues found`
            )

        } catch (error: any) {
            console.error('Validation error:', error)
            const errorMessage = error.response?.data?.message || error.message || 'Validation failed'
            setError(`Validation error: ${errorMessage}`)
            showError(error, user?.role, "Validation failed")
            toast.error('Validation failed. See details above.')
        } finally {
            setValidating(false)
        }
    }

    const getStatusIcon = (status: string) => {
        switch (status) {
            case 'ok':
                return <CheckCircle2 className="h-5 w-5 text-green-500" />
            case 'missing':
                return <XOctagon className="h-5 w-5 text-red-500" />
            case 'mismatch':
                return <AlertOctagon className="h-5 w-5 text-yellow-500" />
            case 'undocumented':
                return <FileQuestion className="h-5 w-5 text-orange-500" />
            default:
                return <FileSearch className="h-5 w-5 text-gray-500" />
        }
    }

    const getStatusColor = (status: string) => {
        switch (status) {
            case 'ok':
                return 'bg-green-500/10 text-green-400 border-green-500/20'
            case 'missing':
                return 'bg-red-500/10 text-red-400 border-red-500/20'
            case 'mismatch':
                return 'bg-yellow-500/10 text-yellow-400 border-yellow-500/20'
            case 'undocumented':
                return 'bg-orange-500/10 text-orange-400 border-orange-500/20'
            default:
                return 'bg-gray-500/10 text-gray-400 border-gray-500/20'
        }
    }

    if (error) {
        return (
            <div className="space-y-8 animate-fade-in">
                <div>
                    <h2 className="text-4xl font-bold text-white tracking-tight text-glow">Structure Validation</h2>
                    <p className="text-gray-400 mt-2 text-lg">Compare ET documents against BIM models.</p>
                </div>
                <Card className="glass-panel border-red-500/20">
                    <CardContent className="p-8">
                        <div className="flex items-start gap-4">
                            <AlertTriangle className="h-8 w-8 text-red-500 flex-shrink-0 mt-1" />
                            <div>
                                <h3 className="text-xl font-bold text-red-400 mb-2">Error in Validation Module</h3>
                                <p className="text-gray-300 mb-4">{error}</p>
                                <p className="text-sm text-gray-500 mb-4">
                                    This error is isolated to the validation module. The rest of the application continues to work normally.
                                </p>
                                <Button 
                                    onClick={() => { setError(null); window.location.reload() }}
                                    className="bg-red-500 hover:bg-red-600"
                                >
                                    Retry
                                </Button>
                            </div>
                        </div>
                    </CardContent>
                </Card>
            </div>
        )
    }

    return (
        <div className="space-y-8 animate-fade-in relative">
            {/* Floating Notification Panel */}
            {notifications.length > 0 && (
                <div className="fixed top-4 right-4 z-[100] w-96 max-h-[80vh] overflow-y-auto">
                    <Card className="bg-gray-900/95 backdrop-blur-xl border-red-500/30 shadow-2xl">
                        <CardHeader className="pb-3 border-b border-red-500/20">
                            <div className="flex items-center justify-between">
                                <div className="flex items-center gap-3">
                                    <div className="p-2 bg-red-500/20 rounded-lg">
                                        <AlertCircle className="h-5 w-5 text-red-400 animate-pulse" />
                    <Card className="glass-panel border-white/10 relative z-10">
                        <CardHeader className="bg-gradient-to-r from-blue-500/10 to-purple-500/10 border-b border-white/10">
                            <CardTitle className="flex items-center gap-2 text-lg">
                                <Layers className="h-5 w-5 text-blue-400" />
                                Select Project
                            </CardTitle>
                            <CardDescription>Choose project and model files to validate</CardDescription>
                        </CardHeader>ariant="ghost"
                                    size="sm"
                                    onClick={() => setNotifications([])}
                                    className="h-8 w-8 p-0 hover:bg-red-500/20"
                                >
                                    <X className="h-4 w-4 text-gray-400" />
                                </Button>
                            </div>
                        </CardHeader>
                        <CardContent className="p-0">
                            <div className="max-h-[60vh] overflow-y-auto">
                                {notifications.map((notification, idx) => {
                                    const type = notification.split(':')[0].trim()
                                    const message = notification.substring(notification.indexOf(':') + 1).trim()
                                    
                                    return (
                                        <div
                                            key={idx}
                                            className={`p-4 border-b border-white/5 hover:bg-white/5 transition-colors ${
                                                type === 'MISSING' ? 'border-l-4 border-l-red-500' :
                                                type === 'MISMATCH' ? 'border-l-4 border-l-yellow-500' :
                                                'border-l-4 border-l-orange-500'
                                            }`}
                                        >
                                            <div className="flex items-start gap-3">
                                                <div className="mt-1">
                                                    {type === 'MISSING' ? (
                                                        <XOctagon className="h-5 w-5 text-red-400" />
                                                    ) : type === 'MISMATCH' ? (
                                                        <AlertOctagon className="h-5 w-5 text-yellow-400" />
                                                    ) : (
                                                        <FileQuestion className="h-5 w-5 text-orange-400" />
                                                    )}
                                                </div>
                                                <div className="flex-1">
                                                    <div className={`text-xs font-semibold mb-1 ${
                                                        type === 'MISSING' ? 'text-red-400' :
                                                        type === 'MISMATCH' ? 'text-yellow-400' :
                                                        'text-orange-400'
                                                    }`}>
                                                        {type}
                                                    </div>
                                                    <div className="text-sm text-gray-300 leading-tight">
                                                        {message}
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    )
                                })}
                            </div>
                        </CardContent>
                    </Card>
                </div>
            )}

            <div>
                <h2 className="text-4xl font-bold text-white tracking-tight text-glow">Structure Validation</h2>
                <p className="text-gray-400 mt-2 text-lg">Compare ET documents against BIM models.</p>
            </div>

            <div className="grid grid-cols-1 xl:grid-cols-12 gap-6">
                {/* Configuration Panel */}
                <div className="xl:col-span-4 space-y-6">
                    {/* Project Selection Card */}
                    <Card className="glass-panel border-white/10 relative z-10">
                        <CardHeader className="bg-gradient-to-r from-blue-500/10 to-purple-500/10 border-b border-white/10">
                            <CardTitle className="flex items-center gap-2 text-lg">
                                <Box className="h-5 w-5 text-blue-400" />
                                Select Project
                            </CardTitle>
                            <CardDescription>Choose project and model files to validate</CardDescription>
                        </CardHeader>
                            {selectedProject && (
                                <div className="space-y-3 animate-fade-in">
                                    <label className="text-sm font-semibold text-gray-300 flex items-center gap-2">
                                        <Settings className="h-4 w-4 text-purple-400" />
                                        Model Files ({selectedProject.files?.length || 0})
                                    </label>ssName="h-8 bg-white/5 rounded-xl animate-pulse"></div>
                                </div>
                            ) : (
                                <div className="space-y-3 relative">
                                    <label className="text-sm font-semibold text-gray-300">Project</label>
                                    <div className="relative">
                                        <button
                                            onClick={() => setShowProjectDropdown(!showProjectDropdown)}
                                            className="w-full bg-gradient-to-br from-white/10 to-white/5 border border-white/20 rounded-xl px-4 py-3.5 text-left text-white hover:border-blue-400/50 transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-blue-500/50 flex items-center justify-between group relative z-10"
                                        >
                                            <span className="flex items-center gap-3">
                                                {selectedProject ? (
                                                    <>
                                                        <div className="h-2 w-2 rounded-full bg-green-400 animate-pulse"></div>
                                                        <span className="font-medium">{selectedProject.name}</span>
                                                    </>
                                                ) : (
                                                    <>
                                                        <div className="h-2 w-2 rounded-full bg-gray-500"></div>
                                                        <span className="text-gray-400">Select a project...</span>
                                                    </>
                                                )}
                                            </span>
                                            <svg className={`h-5 w-5 text-gray-400 transition-transform duration-200 ${showProjectDropdown ? 'rotate-180' : ''}`} fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M19 9l-7 7-7-7" />
                                            </svg>
                                        </button>
                                        
                                        ) : (
                                            <div className="text-center py-6 text-gray-500 text-sm">
                                                <FileSearch className="h-8 w-8 mx-auto mb-2 opacity-30" />
                                                No model files in this project
                                            </div>
                                        )}
                                    </div>
                                    {selectedFiles.length > 0 && (
                                        <div className="text-xs text-green-400 flex items-center gap-2 bg-green-500/10 px-3 py-2 rounded-lg">
                                            <CheckCircle2 className="h-4 w-4" />
                                            {selectedFiles.length} file{selectedFiles.length > 1 ? 's' : ''} selected
                                        </div>
                                    )}                      setShowProjectDropdown(false)
                                                            toast.success(`Selected: ${project.name}`)
                                                        }}
                                                        className={`w-full px-4 py-3 text-left hover:bg-blue-500/20 transition-all duration-150 flex items-center gap-3 ${
                                                            idx !== projects.length - 1 ? 'border-b border-white/5' : ''
                                                        } ${selectedProject?.id === project.id ? 'bg-blue-500/10 text-blue-400' : 'text-gray-300'}`}
                                                    >
                                                        <div className={`h-2 w-2 rounded-full ${selectedProject?.id === project.id ? 'bg-blue-400' : 'bg-gray-600'}`}></div>
                                                        <div className="flex-1">
                                                            <div className="font-medium">{project.name}</div>
                                                            {project.description && (
                                                                <div className="text-xs text-gray-500 mt-0.5">{project.description}</div>
                                                            )}
                                                            <div className="text-xs text-gray-600 mt-1">{project.files?.length || 0} files</div>
                                                        </div>
                                                        {selectedProject?.id === project.id && (
                                                            <CheckCircle className="h-4 w-4 text-blue-400" />
                                                        )}
                                                    </button>
                                                ))}
                                            </div>
                                        )}
                                    </div>
                                </div>
                            )}

                            {/* Model Files Selection */}
                            {selectedProject && (
                                <div className="space-y-3 animate-fade-in">
                                    <label className="text-sm font-semibold text-gray-300 flex items-center gap-2">
                                        <FileText className="h-4 w-4 text-purple-400" />
                                {etDocument ? (
                                    <>
                                        <CheckCircle2 className="h-12 w-12 text-green-400 animate-pulse" />
                                        <div className="text-center">
                                            <div className="font-semibold text-white">{etDocument.name}</div>
                                            <div className="text-xs text-gray-400 mt-1">
                                                {(etDocument.size / 1024 / 1024).toFixed(2)} MB • {etDocument.type.includes('pdf') ? 'PDF' : 'Word'}
                                            </div>
                                        </div>
                                        <div className="text-xs text-green-400">Click to change</div>
                                    </>
                                ) : (
                                    <>
                                        <div className="relative">
                                            <FileSearch className="h-12 w-12 text-amber-400" />
                                            <div className="absolute -bottom-1 -right-1 bg-blue-500 rounded-full p-1">
                                                <Upload className="h-3 w-3 text-white" />
                                            </div>
                                        </div>          }}
                                                        className="h-4 w-4 rounded border-gray-600 text-blue-500 focus:ring-blue-500 focus:ring-offset-gray-900"
                                                    />
                                                    <div className="flex-1">
                                                        <div className="text-sm font-medium text-white group-hover:text-blue-400 transition-colors">
                                                            {file.name}
                                                        </div>
                                                        <div className="text-xs text-gray-500">{file.type} • {(file.size / 1024 / 1024).toFixed(2)} MB</div>
                                                    </div>
                                                </label>
                                            ))
                                        ) : (
                                            <div className="text-center py-6 text-gray-500 text-sm">
                                                <FileWarning className="h-8 w-8 mx-auto mb-2 opacity-30" />
                                                No model files in this project
                                            </div>
                                        )}
                                    <>
                                        <Loader2 className="h-5 w-5 mr-2 animate-spin" />
                                        Validating...
                                    </>
                                ) : (
                                    <>
                                        <FileSearch className="h-5 w-5 mr-2" />
                                        Start Validation
                                    </>
                                )}ent>
                    </Card>

                    {/* ET Document Upload Card */}
                    <Card className="glass-panel border-white/10 overflow-hidden relative z-0">
                        <CardHeader className="bg-gradient-to-r from-amber-500/10 to-orange-500/10 border-b border-white/10">
                {/* Results Panel */}
                <div className="xl:col-span-8 space-y-6">
                    {/* Statistics Dashboard */}
                                {etDocument ? (
                                    <>
                                        <CheckCircle className="h-12 w-12 text-green-400 animate-pulse" />
                                        <div className="text-center">
                                            <div className="font-semibold text-white">{etDocument.name}</div>
                                            <div className="text-xs text-gray-400 mt-1">
                                                {(etDocument.size / 1024 / 1024).toFixed(2)} MB • {etDocument.type.includes('pdf') ? 'PDF' : 'Word'}
                                            </div>
                                        </div>
                                        <div className="text-xs text-green-400">Click to change</div>
                                    </>
                                ) : (
                                    <>
                                        <div className="relative">
                                            <FileText className="h-12 w-12 text-amber-400" />
                                            <div className="absolute -bottom-1 -right-1 bg-blue-500 rounded-full p-1">
                                                <Upload className="h-3 w-3 text-white" />
                                            </div>
                                        </div>
                                        <div className="text-center">
                                            <div className="font-medium text-white">Click to upload ET document</div>
                            <Card className="glass-panel border-white/10">
                                <CardContent className="p-4">
                                    <div className="flex items-center justify-between">
                                        <div>
                                            <p className="text-xs text-gray-500 uppercase">Total</p>
                                            <p className="text-2xl font-bold text-white">{validationSummary.total}</p>
                                        </div>
                                        <BarChart3 className="h-8 w-8 text-gray-500" />
                                    </div>
                                </CardContent>
                            </Card>

                            <Card className="glass-panel border-green-500/20 bg-green-500/5">
                                <CardContent className="p-4">
                                    <div className="flex items-center justify-between">
                                        <div>
                                            <p className="text-xs text-green-400 uppercase">OK</p>
                                            <p className="text-2xl font-bold text-green-400">{validationSummary.ok}</p>
                                        </div>
                                        <CheckCircle2 className="h-8 w-8 text-green-500" />
                                    </div>
                                </CardContent>
                            </Card>

                            <Card className="glass-panel border-red-500/20 bg-red-500/5">
                                <CardContent className="p-4">
                                    <div className="flex items-center justify-between">
                                        <div>
                                            <p className="text-xs text-red-400 uppercase">Missing</p>
                                            <p className="text-2xl font-bold text-red-400">{validationSummary.missing}</p>
                                        </div>
                                        <XOctagon className="h-8 w-8 text-red-500" />
                                    </div>
                                </CardContent>
                            </Card>

                            <Card className="glass-panel border-yellow-500/20 bg-yellow-500/5">
                                <CardContent className="p-4">
                                    <div className="flex items-center justify-between">
                                        <div>
                                            <p className="text-xs text-yellow-400 uppercase">Mismatch</p>
                                            <p className="text-2xl font-bold text-yellow-400">{validationSummary.mismatch}</p>
                                        </div>
                                        <AlertOctagon className="h-8 w-8 text-yellow-500" />
                                    </div>
                                </CardContent>
                            </Card>

                            <Card className="glass-panel border-orange-500/20 bg-orange-500/5">
                                <CardContent className="p-4">
                                    <div className="flex items-center justify-between">
                                        <div>
                                            <p className="text-xs text-orange-400 uppercase">Undoc.</p>
                                            <p className="text-2xl font-bold text-orange-400">{validationSummary.undocumented}</p>
                                        </div>
                                        <FileQuestion className="h-8 w-8 text-orange-500" />
                                    </div>
                                </CardContent>
                            </Card>         <p className="text-2xl font-bold text-white">{validationSummary.total}</p>
                                        </div>
                                        <Box className="h-8 w-8 text-gray-500" />
                                    </div>
                                </CardContent>
                            </Card>
                        <CardHeader>
                            <div className="flex items-center justify-between">
                                <div className="flex items-center gap-3">
                                    <TrendingUp className="h-5 w-5 text-blue-400" />
                                    <div>
                                        <CardTitle>Validation Results</CardTitle>
                                        <CardDescription>
                                            {validationResults.length > 0 
                                                ? `${validationResults.length} instruments analyzed`
                                                : 'No validation results yet'}
                                        </CardDescription>
                                    </div>
                                </div>
                                {validationResults.length > 0 && (
                                    <div className="flex gap-2">
                                        <Button
                                            variant="outline"
                                            size="sm"
                                            onClick={() => setFilterStatus('all')}
                                            className={`gap-2 ${filterStatus === 'all' ? 'bg-white/10' : ''}`}
                                        >
                                            <Filter className="h-3 w-3" />
                                            All
                                        </Button>
                                        <Button
                                            variant="outline"
                                            size="sm"
                                            onClick={() => setFilterStatus('issues')}
                                            className={`gap-2 ${filterStatus === 'issues' ? 'bg-red-500/20 text-red-400' : ''}`}
                                        >
                                            <AlertCircle className="h-3 w-3" />
                                            Issues Only
                                        </Button>
                            {validationResults.length === 0 ? (
                                <div className="flex flex-col items-center justify-center py-16 text-gray-500">
                                    <FileSearch className="h-16 w-16 mb-4 opacity-20" />
                                    <p className="text-lg font-medium">No validation results</p>
                                    <p className="text-sm">Configure and run a validation to see results</p>
                                </div>div>
                                </CardContent>
                            </Card>

                            <Card className="glass-panel border-orange-500/20 bg-orange-500/5">
                                <CardContent className="p-4">
                                    <div className="flex items-center justify-between">
                                        <div>
                                            <p className="text-xs text-orange-400 uppercase">Undoc.</p>
                                            <p className="text-2xl font-bold text-orange-400">{validationSummary.undocumented}</p>
                                        </div>
                                        <FileWarning className="h-8 w-8 text-orange-500" />
                                    </div>
                                </CardContent>
                            </Card>
                        </div>
                    )}

                    {/* Results Table */}
                    <Card className="glass-panel border-white/10">
                        <CardHeader>
                            <div className="flex items-center justify-between">
                                <div>
                                    <CardTitle>Validation Results</CardTitle>
                                    <CardDescription>
                                        {validationResults.length > 0 
                                            ? `${validationResults.length} instruments analyzed`
                                            : 'No validation results yet'}
                                    </CardDescription>
                                </div>
                                {validationResults.length > 0 && (
                                    <div className="flex gap-2">
                                        <Button
                                            variant="outline"
                                            size="sm"
                                            onClick={() => setFilterStatus('all')}
                                            className={filterStatus === 'all' ? 'bg-white/10' : ''}
                                        >
                                            All
                                        </Button>
                                        <Button
                                            variant="outline"
                                            size="sm"
                                            onClick={() => setFilterStatus('issues')}
                                            className={filterStatus === 'issues' ? 'bg-red-500/20 text-red-400' : ''}
                                        >
                                            Issues Only
                                        </Button>
                                    </div>
                                )}
                            </div>
                        </CardHeader>
                        <CardContent>
                            {validationResults.length === 0 ? (
                                <div className="flex flex-col items-center justify-center py-16 text-gray-500">
                                    <FileCheck className="h-16 w-16 mb-4 opacity-20" />
                                    <p className="text-lg font-medium">No validation results</p>
                                    <p className="text-sm">Configure and run a validation to see results</p>
                                </div>
                            ) : (
                                <div className="overflow-x-auto">
                                    <table className="w-full">
                                        <thead>
                                            <tr className="border-b border-white/10">
                                                <th className="text-left py-3 px-4 text-xs font-semibold text-gray-400 uppercase">Status</th>
                                                <th className="text-left py-3 px-4 text-xs font-semibold text-gray-400 uppercase">Instrument Tag</th>
                                                <th className="text-left py-3 px-4 text-xs font-semibold text-gray-400 uppercase">Type</th>
                                                <th className="text-left py-3 px-4 text-xs font-semibold text-gray-400 uppercase">Location</th>
                                                <th className="text-left py-3 px-4 text-xs font-semibold text-gray-400 uppercase">Message</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {validationResults
                                                .filter(result => filterStatus === 'all' || (filterStatus === 'issues' && result.status !== 'ok'))
                                                .map((result) => (
                                                <tr key={result.id} className="border-b border-white/5 hover:bg-white/5 transition-colors">
                                                    <td className="py-3 px-4">
                                                        <div className="flex items-center gap-2">
                                                            {getStatusIcon(result.status)}
                                                            <span className={`text-xs font-medium uppercase ${
                                                                result.status === 'ok' ? 'text-green-400' :
                                                                result.status === 'missing' ? 'text-red-400' :
                                                                result.status === 'mismatch' ? 'text-yellow-400' :
                                                                'text-orange-400'
                                                            }`}>
                                                                {result.status}
                                                            </span>
                                                        </div>
                                                    </td>
                                                    <td className="py-3 px-4">
                                                        <span className="font-mono font-semibold text-white">{result.instrumentTag}</span>
                                                    </td>
                                                    <td className="py-3 px-4">
                                                        <span className="text-sm text-gray-400">
                                                            {result.etData?.type || result.modelData?.type || '-'}
                                                        </span>
                                                    </td>
                                                    <td className="py-3 px-4">
                                                        <span className="text-sm text-gray-400">
                                                            {result.etData?.level && result.etData?.room 
                                                                ? `${result.etData.level} / ${result.etData.room}`
                                                                : result.modelData?.level && result.modelData?.room
                                                                ? `${result.modelData.level} / ${result.modelData.room}`
                                                                : '-'}
                                                        </span>
                                                    </td>
                                                    <td className="py-3 px-4">
                                                        <span className="text-sm text-gray-300">{result.message}</span>
                                                    </td>
                                                </tr>
                                            ))}
                                        </tbody>
                                    </table>
                                </div>
                            )}
                        </CardContent>
                    </Card>
                </div>
            </div>
        </div>
    )
}
