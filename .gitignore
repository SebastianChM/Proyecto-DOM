# Root level gitignore
# Reorganized for apps/, packages/, tools/, reports/, storage/ structure

# Dependencies
node_modules/
apps/*/package-lock.json
packages/*/package-lock.json
.pnp
.pnp.js

# Build outputs
dist/
build/
*.tsbuildinfo
apps/api/dist/
apps/web/.next/
apps/web/out/

# Testing
coverage/
.nyc_output

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
apps/api/logs/
storage/logs/

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Databases
*.db
*.db-journal
*.db-shm
*.db-wal
apps/api/test.db
packages/database/prisma/dev.db
packages/database/prisma/*.db
storage/*.db

# Environment files
.env
.env.local
.env.*.local
!.env.example

# IDE
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.DS_Store

# OS
Thumbs.db
Desktop.ini

# Temporary folders
tmp/
temp/
.tmp/
.dev/

# Reports (generated)
reports/
eslint-report.json
eslint-detailed-report.json
lint-full.txt
lint-output.txt
lint_errors.txt
task_report.html

# Storage & Cache (runtime data)
storage/
cache/
apps/api/downloads/
apps/api/uploads/*
!apps/api/uploads/.gitkeep

# Backups (canonical path is storage/backups/, covered by storage/ above)
# Legacy paths kept for safety
packages/database/prisma/backups/
backups/

# Docker
.docker/

# Debug and test artifacts
*debug*.txt
*debug*.log
test_*.txt
test_output.log
upload_*.txt

# Sensitive documentation (moved to external secure location)
SECURITY_DOCUMENTATION.md
remote-access-info.txt

# Misc
*.tgz
.npm
.eslintcache
.cache/
tmpclaude-*

# Generated reports (keep out of version control)
eslint-report.json
eslint-detailed-report.json
lint-full.txt
lint-output.txt
project_tree.txt

# Gemini artifacts (optional - uncomment if you don't want to commit)
# .gemini/

# Temporary test directory (artifacts, hardcoded paths)
temp_empty/

# Project management & audit artifacts
TICKETS_*.md
revision/
PDFs Chile/
Plan GPT/
HITO*_EVIDENCE.md

# Test evidence/reports (generated, not source)
**/EVIDENCE.md
**/*_TEST_SUMMARY.md
**/*_TEST_RESULTS.md

# Documentation & Context exclusions
docs/context/
docs/hitos/
docs/guides/
docs/*_CONTEXT.md
docs/*_EVIDENCE.md
docs/*_ADMIN*.md
docs/SOLUCION_FINAL_ENV.md
docs/INSTRUCCIONES_FINALES_CONFIDENCIAL.md
docs/LISTA_COMPLETA_ARCHIVOS.csv
docs/TODO.md
docs/TREE_COMPLETO.txt
docs/TICKETS_TRACKER.md
docs/VIEWER_FIX_VERIFICATION.md

# Local AI/agent artifacts (not source code)
CLAUDE.md
.github/prompts/
