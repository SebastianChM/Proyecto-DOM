# ──────────────────────────────────────────────────────────────
# DOM BIM Platform — Environment Variables
# Copy to .env and fill in your values. See apps/api/src/config/env.ts
# for full schema, defaults, and validation rules.
# ──────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────
NODE_ENV=development
PORT=8080

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/dom_bim

# ── Redis (provide URL *or* HOST+PORT) ──────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# REDIS_URL=redis://localhost:6379   # alternative to HOST+PORT

# ── APS (Autodesk Platform Services) ────────────────────────
APS_CLIENT_ID=CHANGE_ME_YOUR_CLIENT_ID
APS_CLIENT_SECRET=CHANGE_ME_YOUR_CLIENT_SECRET
APS_CALLBACK_URL=http://localhost:3000/auth/callback
APS_BUCKET=CHANGE_ME_YOUR_BUCKET_NAME
# APS_MOCK=false                     # true = bypass real Autodesk calls (dev/test only, forbidden in production)
# APS_DA_NICKNAME=                   # Design Automation nickname (defaults to APS_CLIENT_ID)

# ── APS Webhooks ─────────────────────────────────────────────
APS_WEBHOOK_SIGNING_SECRET=CHANGE_ME_MUST_MATCH_APS_CONSOLE
APS_WEBHOOK_URL=https://your-domain.com/api/webhooks/aps

# ── Session & Security ──────────────────────────────────────
SESSION_SECRET=CHANGE_ME_MINIMUM_32_CHARACTERS_REQUIRED_FOR_SECURITY
WEBHOOK_SECRET=CHANGE_ME_MINIMUM_16_CHARACTERS

# ── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ── Frontend URL (used for OAuth redirects) ─────────────────
# FRONTEND_URL=http://localhost:3000  # optional, defaults to localhost:3000

# ── Admin ────────────────────────────────────────────────────
ADMIN_EMAILS=admin@example.com

# ── Workers ──────────────────────────────────────────────────
WEBHOOK_QUEUE_CONCURRENCY=5
POLLING_INTERVAL_MINUTES=30
RUN_WORKERS=false

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=info

# ── Proxy & HTTPS (production) ──────────────────────────────
TRUST_PROXY=false
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
HSTS_ENABLED=false

# ── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_STORE=redis

# ── Conversion Concurrency ──────────────────────────────────
CONVERSION_CONCURRENCY=10
CONVERSION_MD_CONCURRENCY=8
CONVERSION_DA_CONCURRENCY=5
CONVERSION_MAX_ATTEMPTS=3
CONVERSION_BACKOFF_DELAY=2000

# ── Upload & Demo ───────────────────────────────────────────
# MAX_FILE_SIZE_BYTES=209715200       # optional, defaults to 200 MB
# DEMO_MODE=false

# ── SMTP (optional — all-or-none: set all or leave all unset) ─
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user@example.com
# SMTP_PASS=your_smtp_password
# SMTP_SECURE=false
# SMTP_FROM="BIM Platform" <noreply@example.com>

# ── External Transport (optional — Sentry error tracking) ───
# SENTRY_DSN=https://key@sentry.io/project
# SENTRY_TRACES_SAMPLE_RATE=0.1      # 0–1, default 0.1

# ── Feature Flags ───────────────────────────────────────────
APS_WARMUP_ON_START=false
ENABLE_DEBUG_ROUTES=false
ALLOW_NO_ORIGIN=false
DEV_ALLOW_NGROK=false
SKIP_WEBHOOK_VALIDATION=false
ALLOW_EMPTY_ADMIN_EMAILS=false
