# APS Configuration
APS_CLIENT_ID=CHANGE_ME_YOUR_CLIENT_ID
APS_CLIENT_SECRET=CHANGE_ME_YOUR_CLIENT_SECRET
APS_CALLBACK_URL=http://localhost:3000/auth/callback
APS_BUCKET=CHANGE_ME_YOUR_BUCKET_NAME

# APS Webhooks
APS_WEBHOOK_SIGNING_SECRET=CHANGE_ME_MUST_MATCH_APS_CONSOLE
APS_WEBHOOK_URL=https://your-domain.com/api/webhooks/aps

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/dom_bim

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Session & Security
SESSION_SECRET=CHANGE_ME_MINIMUM_32_CHARACTERS_REQUIRED_FOR_SECURITY
WEBHOOK_SECRET=CHANGE_ME_MINIMUM_16_CHARACTERS

# CORS
CORS_ORIGINS=http://localhost:3000

# Admin
ADMIN_EMAILS=admin@example.com

# Worker Configuration  
WEBHOOK_QUEUE_CONCURRENCY=5
POLLING_INTERVAL_MINUTES=30
RUN_WORKERS=false

# Logging
LOG_LEVEL=info
NODE_ENV=development

# Server
PORT=8080

# Proxy & HTTPS (for production)
TRUST_PROXY=false
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
HSTS_ENABLED=false

# Rate Limiting
RATE_LIMIT_STORE=redis

# Conversion Concurrency (Hito 5)
CONVERSION_CONCURRENCY=10
CONVERSION_MD_CONCURRENCY=8
CONVERSION_DA_CONCURRENCY=5
CONVERSION_MAX_ATTEMPTS=3
CONVERSION_BACKOFF_DELAY=2000

# Feature Flags
APS_WARMUP_ON_START=false
ENABLE_DEBUG_ROUTES=false
ALLOW_NO_ORIGIN=false
DEV_ALLOW_NGROK=false
SKIP_WEBHOOK_VALIDATION=false
ALLOW_EMPTY_ADMIN_EMAILS=false
