# --- General ---
NODE_ENV=development
PORT=8080

# --- Proxy & HTTPS ---
TRUST_PROXY=false
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
HSTS_ENABLED=false

# --- Database & Cache ---
POSTGRES_USER=dom
POSTGRES_PASSWORD=CHANGE_ME_IN_ENV
POSTGRES_DB=dom_bim
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL="postgresql://dom:CHANGE_ME_IN_ENV@localhost:5432/dom_bim?schema=public"
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Backup Configuration ---
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30

# --- APS (Autodesk Platform Services) ---
APS_CLIENT_ID="CHANGE_ME"
APS_CLIENT_SECRET="CHANGE_ME"
APS_CALLBACK_URL="http://localhost:8080/api/auth/callback"
APS_BUCKET="dom-bim-dev"
APS_WARMUP_ON_START=false
RUN_WORKERS=false
ALLOW_NO_ORIGIN=true
DEV_ALLOW_NGROK=false

# --- Rate Limiting ---
RATE_LIMIT_STORE=redis

# --- Security ---
SESSION_SECRET="CHANGE_ME_AT_LEAST_32_CHARS_RANDOM"
CORS_ORIGINS="http://localhost:3000"
ADMIN_EMAILS=""
ALLOW_EMPTY_ADMIN_EMAILS=false
WEBHOOK_SECRET="CHANGE_ME_GENERATE_RANDOM_32_CHARS"
SKIP_WEBHOOK_VALIDATION=false
ENABLE_DEBUG_ROUTES=false

# --- Frontend Public ---
NEXT_PUBLIC_API_BASE_URL="http://localhost:8080"
NEXTAUTH_URL="http://localhost:3000"
