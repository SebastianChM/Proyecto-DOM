{
  "name": "dom-bim-platform",
  "version": "2.0.0",
  "description": "DOM BIM Platform - Enterprise solution for multi-format BIM management",
  "private": true,
  "engines": {
    "node": ">=20.11.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/database",
    "packages/z-schema-patched"
  ],
  "scripts": {
    "dev:infra": "node tools/scripts/infra.js up -d",
    "dev:wait": "wait-on tcp:127.0.0.1:5432 tcp:127.0.0.1:6379",
    "dev:sync": "node tools/scripts/gen-frontend-env.js",
    "dev:api": "node tools/scripts/start-service.js API npm run dev --prefix apps/api",
    "dev:worker": "node tools/scripts/start-service.js WRK npm run dev:worker --prefix apps/api",
    "dev:frontend": "node tools/scripts/start-service.js WEB npm run dev --prefix apps/web",
    "dev": "npm run dev:infra && npm run dev:wait && npm run dev:sync && concurrently -k -n \"API,WRK,WEB\" \"npm run dev:api\" \"npm run dev:worker\" \"npm run dev:frontend\"",
    "dev:stop": "node tools/scripts/stop-dev.js",
    "dev:reset": "node tools/scripts/infra.js reset",
    "infra:status": "node tools/scripts/infra-status.js",
    "infra:up": "cd infra/docker && docker-compose up -d",
    "infra:down": "cd infra/docker && docker-compose down",
    "db:generate": "npm run db:generate --workspace=packages/database",
    "db:migrate": "npm run db:migrate --workspace=packages/database",
    "db:studio": "npm run db:studio --workspace=packages/database",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "concurrently \"tsc --noEmit --project apps/api/tsconfig.json\" \"tsc --noEmit --project apps/web/tsconfig.json\"",
    "security:scan": "node tools/scripts/security-scan.js",
    "db:backup": "node tools/scripts/backup-db.js",
    "db:restore": "node tools/scripts/restore-db.js",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@types/cookie-session": "^2.0.49",
    "@types/pdfkit": "^0.17.5",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.7.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "tree-kill": "^1.2.2",
    "typescript-eslint": "^8.50.0",
    "wait-on": "^9.0.3"
  },
  "overrides": {
    "rimraf": "^4.4.1",
    "glob": "^13.0.0",
    "unzipper": "^0.12.3"
  },
  "dependencies": {
    "validator": "^13.15.26"
  }
}
